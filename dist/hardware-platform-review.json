{
  "schemaVersion": 1,
  "date": "2026-10-11",
  "sourceRevision": "a91f4b4774f25de061fe1a7c132a91ddde117fca",
  "snapshotCatalogId": "b4b1026b74ad8bf0a1628c9889b82193d33d210c3aa0170e94783f371fe15c0b",
  "rule": "For hardware and platform integrations, connected QML user functionality plus existing tests and integration hooks is sufficient for acceptance. Physical-device runs, every operating system, external-service runs and matching captures are not prerequisites. Missing user workflows and recorded failures remain gaps.",
  "criteria": {
    "F14.S06": {
      "basis": "qml-tests-hooks",
      "reason": "The review page lets the user save a transaction for further signing. Model tests preserve an incomplete external-signer result and imported PSBT metadata; component tests expose the more-signatures-required state. These satisfy the signing-handoff outcome.",
      "qml": [
        "qml/pages/wallet/SendTransactionReview.qml",
        "qml/components/ExternalSignerReviewActions.qml"
      ],
      "hooks": [
        "qml/models/walletqmlmodel.cpp"
      ],
      "tests": [
        {
          "label": "Incomplete signer result is saved",
          "path": "test/test_walletqmlmodel.cpp",
          "log": "logs/qml-unit-tests.log",
          "recordedAssertion": "PASS   : WalletQmlModelTests::externalSignerApprovalKeepsIncompleteSignedPsbt()"
        },
        {
          "label": "Imported PSBT metadata is preserved",
          "path": "test/test_walletqmlmodel.cpp",
          "log": "logs/qml-unit-tests.log",
          "recordedAssertion": "PASS   : WalletQmlModelTests::saveCurrentTransactionAsPsbt_preservesImportedMetadata()"
        },
        {
          "label": "Additional-signature state is presented",
          "path": "test/qml/tst_externalsignerreviewactions.qml",
          "log": "logs/qml-quick-tests.log",
          "recordedAssertion": "PASS   : bitcoinqml_qmltests::ExternalSignerReviewActions::test_partial_success_shows_more_signatures_message()"
        }
      ],
      "limits": "Assessment trusts the existing signer/model tests and QML save flow. No new multisigner-device exchange or matching partial-signature capture was collected; file export provides the handoff."
    },
    "F15.S01": {
      "basis": "qml-tests-hooks",
      "reason": "The user can configure compatible signer software, check for a device, and create a signer-backed wallet. The recorded functional test drives those QML controls and discovers the mock signer.",
      "qml": [
        "qml/pages/settings/ExternalSignerSettingsPage.qml",
        "qml/pages/wallet/WalletCreationTypePage.qml"
      ],
      "hooks": [
        "qml/walletqmlcontroller.cpp"
      ],
      "tests": [
        {
          "label": "External signer functional flow",
          "path": "test/functional/qml_test_external_signer.py",
          "log": "logs/qml_test_external_signer.log",
          "recordedAssertion": "External signer GUI flow passed."
        }
      ],
      "limits": "The executable mock stands in for the compatible physical signer. Device-lab repetition is not required by this review standard."
    },
    "F15.S02": {
      "basis": "qml-tests-hooks",
      "reason": "Signer-backed wallet creation disables local private keys, and the QML wallet settings omit local-key password controls. The recorded functional test checks private_keys_enabled is false; signing remains delegated to the external signer.",
      "qml": [
        "qml/pages/settings/WalletSectionPage.qml",
        "qml/pages/wallet/SendTransactionReview.qml"
      ],
      "hooks": [
        "qml/walletqmlcontroller.cpp",
        "qml/models/walletqmlmodel.cpp"
      ],
      "tests": [
        {
          "label": "External signer functional flow",
          "path": "test/functional/qml_test_external_signer.py",
          "log": "logs/qml_test_external_signer.log",
          "recordedAssertion": "External signer GUI flow passed."
        }
      ],
      "limits": "This accepts the application key-separation workflow. It does not claim that a physical device or its firmware was examined."
    },
    "F15.S04": {
      "basis": "qml-tests-hooks",
      "reason": "The payment review offers device approval, a waiting state, errors/retry, and sending after approval. The mock-signer functional test exercises failure recovery, approval and broadcast through that QML flow.",
      "qml": [
        "qml/pages/wallet/SendTransactionReview.qml",
        "qml/components/ExternalSignerReviewActions.qml"
      ],
      "hooks": [
        "qml/models/walletqmlmodel.cpp"
      ],
      "tests": [
        {
          "label": "External signer functional flow",
          "path": "test/functional/qml_test_external_signer.py",
          "log": "logs/qml_test_external_signer.log",
          "recordedAssertion": "External signer GUI flow passed."
        },
        {
          "label": "Approval waiting and completion",
          "path": "test/qml/tst_externalsignerreviewactions.qml",
          "log": "logs/qml-quick-tests.log",
          "recordedAssertion": "PASS   : bitcoinqml_qmltests::ExternalSignerReviewActions::test_waiting_state_persists_until_mock_completes()"
        }
      ],
      "limits": "Physical button presses are represented by the signer hook and tests, not a new hardware run."
    },
    "F16.S09": {
      "basis": "qml-tests-hooks",
      "reason": "Transaction details provide an explorer action whose URL is built by the tested options model and passed to Qt.openUrlExternally. The connected user action and browser handoff meet the outcome.",
      "qml": [
        "qml/pages/wallet/TransactionDetail.qml"
      ],
      "hooks": [
        "qml/models/options_model.cpp"
      ],
      "tests": [
        {
          "label": "Explorer URL construction",
          "path": "test/test_options_model.cpp",
          "log": "logs/qml-unit-tests.log",
          "recordedAssertion": "PASS   : OptionsModelTests::thirdPartyTransactionLinksParseValidUrls()"
        }
      ],
      "limits": "The operating-system browser launcher and remote explorer are trusted integration boundaries; no external service or browser capture is required."
    },
    "F20.S07": {
      "basis": "qml-tests-hooks",
      "reason": "Startup selects the configured Core chain, supplies its chain model to QML, and exposes a network-aware wallet/node shell. Network-style tests cover mainnet, testnet, testnet4, signet and regtest; the existing application scenarios exercise regtest.",
      "qml": [
        "qml/pages/MainWindow.qml",
        "qml/components/NetworkIndicator.qml"
      ],
      "hooks": [
        "qml/bitcoin.cpp",
        "qml/models/chainmodel.cpp",
        "qml/networkstyle.cpp"
      ],
      "tests": [
        {
          "label": "Known network identities",
          "path": "test/test_networkstyle.cpp",
          "log": "logs/qml-unit-tests.log",
          "recordedAssertion": "PASS   : NetworkStyleTests::getTitleAddText_perNetwork()"
        }
      ],
      "limits": "Core chain selection and the common QML integration are trusted. Downloading each public chain is not an acceptance requirement here."
    },
    "F21.S03": {
      "basis": "qml-tests-hooks",
      "reason": "The user can configure and validate a default SOCKS5 proxy and a separate Tor proxy. The QML settings page commits them to Core, and the functional test checks toggles, validation, cancellation and persisted proxy/onion settings.",
      "qml": [
        "qml/pages/settings/ConnectionSettingsPage.qml",
        "qml/pages/settings/ProxySettingsPage.qml"
      ],
      "hooks": [
        "qml/models/core_settings_model.cpp",
        "qml/core_settings.cpp"
      ],
      "tests": [
        {
          "label": "Proxy settings functional flow",
          "path": "test/functional/qml_test_proxy.py",
          "log": "logs/qml_test_proxy.log",
          "recordedAssertion": "All tests PASSED"
        }
      ],
      "limits": "Core routing is trusted once the settings are connected. Live Tor/SOCKS service testing is not required for this QML acceptance assessment."
    },
    "F21.S04": {
      "basis": "qml-tests-hooks",
      "reason": "Connection settings expose automatic NAT-PMP port mapping. The setting reaches the node mapPort hook; the recorded model test verifies live enable/disable calls and persisted settings. This gives users the required router-mapping control.",
      "qml": [
        "qml/pages/settings/ConnectionSettingsPage.qml"
      ],
      "hooks": [
        "qml/models/options_model.cpp",
        "qml/models/core_settings_model.cpp"
      ],
      "tests": [
        {
          "label": "Live router-mapping setting",
          "path": "test/test_options_model.cpp",
          "log": "logs/qml-unit-tests.log",
          "recordedAssertion": "PASS   : OptionsModelTests::natpmpAppliesLiveWithoutRestartDirty()"
        }
      ],
      "limits": "A physical router and a matching screenshot are not required. Actual mapping still depends on a compatible router and build."
    },
    "F24.S01": {
      "basis": "qml-tests-hooks",
      "reason": "The QML window responds to tray Show/Hide and the macOS Dock reopen hook. The controller uses Qt system-tray integration on supported desktops. Existing functional/model tests and native Linux captures demonstrate hide/restore behavior.",
      "qml": [
        "qml/pages/MainWindow.qml"
      ],
      "hooks": [
        "qml/models/desktoptrayiconcontroller.cpp",
        "qml/models/macdockiconhandler.mm"
      ],
      "tests": [
        {
          "label": "Tray functional flow",
          "path": "test/functional/qml_test_tray.py",
          "log": "logs/qml_test_tray.log",
          "recordedAssertion": "All tests PASSED"
        },
        {
          "label": "Restore hidden-window geometry",
          "path": "test/test_desktoptrayiconcontroller.cpp",
          "log": "logs/qml-unit-tests.log",
          "recordedAssertion": "PASS   : DesktopTrayIconControllerTests::showRestoresGeometryCapturedAtHide()"
        }
      ],
      "limits": "Windows and macOS execution is not newly certified; their connected Qt/Dock hooks are sufficient for this review."
    },
    "F26.S03": {
      "basis": "qml-tests-hooks",
      "reason": "Window settings let the user choose minimize-to-tray and minimize-on-close. MainWindow routes those actions to window visibility instead of shutdown, while tray/Dock hooks restore it. Functional/model tests and native Linux RPC checks support continued node operation.",
      "qml": [
        "qml/pages/MainWindow.qml",
        "qml/pages/settings/WindowBehaviorSettingsPage.qml"
      ],
      "hooks": [
        "qml/models/desktopwindowbehaviormodel.cpp",
        "qml/models/desktoptrayiconcontroller.cpp",
        "qml/models/macdockiconhandler.mm"
      ],
      "tests": [
        {
          "label": "Tray functional flow",
          "path": "test/functional/qml_test_tray.py",
          "log": "logs/qml_test_tray.log",
          "recordedAssertion": "All tests PASSED"
        },
        {
          "label": "Close behavior follows user settings",
          "path": "test/test_desktopwindowbehaviormodel.cpp",
          "log": "logs/qml-unit-tests.log",
          "recordedAssertion": "PASS   : DesktopWindowBehaviorModelTests::shouldMinimizeWindowOnClose_requiresDesktopAndMinimizeOnClose()"
        }
      ],
      "limits": "The existing platform hooks are trusted. Additional operating-system screenshots are not acceptance prerequisites."
    },
    "F31.S02": {
      "basis": "qml-tests-hooks",
      "reason": "QML labels non-mainnet networks, and the shell uses network-specific application names, settings and tray/window identities. Network-style tests check the known chains and their title suffixes; the regtest identity is already captured.",
      "qml": [
        "qml/components/NetworkIndicator.qml",
        "qml/pages/wallet/DesktopWallets.qml"
      ],
      "hooks": [
        "qml/bitcoin.cpp",
        "qml/networkstyle.cpp",
        "qml/models/chainmodel.cpp"
      ],
      "tests": [
        {
          "label": "Known network identities",
          "path": "test/test_networkstyle.cpp",
          "log": "logs/qml-unit-tests.log",
          "recordedAssertion": "PASS   : NetworkStyleTests::getTitleAddText_perNetwork()"
        }
      ],
      "limits": "Simultaneous public-network instances are not newly run. The tested identities and connected QML display are sufficient for review."
    }
  },
