      "limits": "Accepted for storage planning. Pruning and wallet-recovery consequences are not explained in the UI. The existing capture and recorded model/component tests are reused; no new disk-space scenario was run."
    },
    "F20.S05": {
      "basis": "qml-tests-hooks",
      "reason": "The real-peer capture already demonstrates synchronization. Model tests verify ETA publication, progress dips and clock regression; component tests verify that reported progress reaches the clock display. QML binds the remaining-time display to the tested tracker through NodeModel. Together these cover the progress-and-estimate outcome.",
      "qml": [
        "qml/components/BlockClock.qml",
        "qml/controls/utils.js"
      ],
      "hooks": [
        "qml/models/nodemodel.cpp",
        "qml/models/syncprogresstracker.cpp"
      ],
      "tests": [
        {
          "label": "ETA remains valid through progress dips",
          "path": "test/test_syncprogresstracker.cpp",
          "recordedAssertion": "SyncProgressTrackerTests::publishesDespiteFrequentProgressDips()",
          "log": "logs/qml-unit-tests.log"
        },
        {
          "label": "Clock regression resets the estimator",
          "path": "test/test_syncprogresstracker.cpp",
          "recordedAssertion": "SyncProgressTrackerTests::resetsForClockRegression()",
          "log": "logs/qml-unit-tests.log"
        },
