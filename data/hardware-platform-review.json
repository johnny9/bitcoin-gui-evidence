    "F20.S03": {
      "basis": "qml-tests-hooks",
      "reason": "The storage-planning outcome is covered by tests for full and pruned disk requirements, insufficient space, and the visible selection controls. QML displays these same model values and prevents unsuitable choices. Additional wallet-recovery guidance is useful documentation, but is not required to plan disk use.",
      "qml": [
        "qml/pages/onboarding/OnboardingStorageAmount.qml",
        "qml/pages/onboarding/OnboardingStorageLocation.qml"
      ],
      "hooks": [
        "qml/onboarding_storage.cpp",
        "qml/models/onboardingoptionsmodel.cpp"
      ],
      "tests": [
