      ],
      "tests": [
        {
          "label": "Proxy settings functional flow",
          "path": "test/functional/qml_test_proxy.py",
          "log": "logs/qml_test_proxy.log",
          "recordedAssertion": "All tests PASSED"
        }
      ],
      "limits": "Core routing is trusted once the settings are connected. Live Tor/SOCKS service testing is not required for this QML acceptance assessment."
    },
    "F21.S04": {
      "basis": "qml-tests-hooks",
      "reason": "Connection settings expose automatic NAT-PMP port mapping. The setting reaches the node mapPort hook; the recorded model test verifies live enable/disable calls and persisted settings. This gives users the required router-mapping control.",
      "qml": [
