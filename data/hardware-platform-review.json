          "recordedAssertion": "PASS   : OptionsModelTests::thirdPartyTransactionLinksParseValidUrls()"
        }
      ],
      "limits": "The operating-system browser launcher and remote explorer are trusted integration boundaries; no external service or browser capture is required."
    },
    "F20.S07": {
      "basis": "qml-tests-hooks",
      "reason": "Startup selects the configured Core chain, supplies its chain model to QML, and exposes a network-aware wallet/node shell. Network-style tests cover mainnet, testnet, testnet4, signet and regtest; the existing application scenarios exercise regtest.",
      "qml": [
        "qml/pages/MainWindow.qml",
        "qml/components/NetworkIndicator.qml"
