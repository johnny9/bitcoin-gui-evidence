  "rule": "Connected QML user functionality plus relevant existing unit, component or functional tests is sufficient for acceptance when their combined coverage demonstrates the main user outcome. Confirm the connection between the tested code and the visible workflow. Repeating every backend command, environment or variant through a new GUI run, and collecting a matching screenshot for transient states, are not prerequisites. Missing user functionality and recorded failures remain gaps.",
  "criteria": {
    "F14.S06": {
      "basis": "qml-tests-hooks",
      "reason": "The review page lets the user save a transaction for further signing. Model tests preserve an incomplete external-signer result and imported PSBT metadata; component tests expose the more-signatures-required state. These satisfy the signing-handoff outcome.",
      "qml": [
        "qml/pages/wallet/SendTransactionReview.qml",
        "qml/components/ExternalSignerReviewActions.qml"
      ],
      "hooks": [
        "qml/models/walletqmlmodel.cpp"
      ],
      "tests": [
        {
          "label": "Incomplete signer result is saved",
          "path": "test/test_walletqmlmodel.cpp",
          "log": "logs/qml-unit-tests.log",
          "recordedAssertion": "PASS   : WalletQmlModelTests::externalSignerApprovalKeepsIncompleteSignedPsbt()"
        },
        {
          "label": "Imported PSBT metadata is preserved",
          "path": "test/test_walletqmlmodel.cpp",
          "log": "logs/qml-unit-tests.log",
          "recordedAssertion": "PASS   : WalletQmlModelTests::saveCurrentTransactionAsPsbt_preservesImportedMetadata()"
        },
        {
          "label": "Additional-signature state is presented",
          "path": "test/qml/tst_externalsignerreviewactions.qml",
          "log": "logs/qml-quick-tests.log",
          "recordedAssertion": "PASS   : bitcoinqml_qmltests::ExternalSignerReviewActions::test_partial_success_shows_more_signatures_message()"
        }
      ],
      "limits": "Assessment trusts the existing signer/model tests and QML save flow. No new multisigner-device exchange or matching partial-signature capture was collected; file export provides the handoff."
    },
    "F15.S01": {
      "basis": "qml-tests-hooks",
      "reason": "The user can configure compatible signer software, check for a device, and create a signer-backed wallet. The recorded functional test drives those QML controls and discovers the mock signer.",
      "qml": [
        "qml/pages/settings/ExternalSignerSettingsPage.qml",
        "qml/pages/wallet/WalletCreationTypePage.qml"
      ],
      "hooks": [
        "qml/walletqmlcontroller.cpp"
      ],
      "tests": [
        {
          "label": "External signer functional flow",
          "path": "test/functional/qml_test_external_signer.py",
          "log": "logs/qml_test_external_signer.log",
          "recordedAssertion": "External signer GUI flow passed."
        }
      ],
      "limits": "The executable mock stands in for the compatible physical signer. Device-lab repetition is not required by this review standard."
    },
    "F15.S02": {
      "basis": "qml-tests-hooks",
      "reason": "Signer-backed wallet creation disables local private keys, and the QML wallet settings omit local-key password controls. The recorded functional test checks private_keys_enabled is false; signing remains delegated to the external signer.",
      "qml": [
        "qml/pages/settings/WalletSectionPage.qml",
        "qml/pages/wallet/SendTransactionReview.qml"
      ],
      "hooks": [
        "qml/walletqmlcontroller.cpp",
        "qml/models/walletqmlmodel.cpp"
      ],
      "tests": [
        {
          "label": "External signer functional flow",
          "path": "test/functional/qml_test_external_signer.py",
          "log": "logs/qml_test_external_signer.log",
          "recordedAssertion": "External signer GUI flow passed."
        }
      ],
      "limits": "This accepts the application key-separation workflow. It does not claim that a physical device or its firmware was examined."
    },
    "F15.S04": {
      "basis": "qml-tests-hooks",
      "reason": "The payment review offers device approval, a waiting state, errors/retry, and sending after approval. The mock-signer functional test exercises failure recovery, approval and broadcast through that QML flow.",
      "qml": [
        "qml/pages/wallet/SendTransactionReview.qml",
        "qml/components/ExternalSignerReviewActions.qml"
      ],
      "hooks": [
        "qml/models/walletqmlmodel.cpp"
      ],
      "tests": [
        {
          "label": "External signer functional flow",
          "path": "test/functional/qml_test_external_signer.py",
          "log": "logs/qml_test_external_signer.log",
          "recordedAssertion": "External signer GUI flow passed."
        },
        {
          "label": "Approval waiting and completion",
          "path": "test/qml/tst_externalsignerreviewactions.qml",
          "log": "logs/qml-quick-tests.log",
          "recordedAssertion": "PASS   : bitcoinqml_qmltests::ExternalSignerReviewActions::test_waiting_state_persists_until_mock_completes()"
        }
      ],
      "limits": "Physical button presses are represented by the signer hook and tests, not a new hardware run."
    },
    "F16.S09": {
      "basis": "qml-tests-hooks",
      "reason": "Transaction details provide an explorer action whose URL is built by the tested options model and passed to Qt.openUrlExternally. The connected user action and browser handoff meet the outcome.",
