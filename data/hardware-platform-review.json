          "log": "logs/qml-unit-tests.log",
          "recordedAssertion": "PASS   : NetworkStyleTests::getTitleAddText_perNetwork()"
        }
      ],
      "limits": "Core chain selection and the common QML integration are trusted. Downloading each public chain is not an acceptance requirement here."
    },
    "F21.S03": {
      "basis": "qml-tests-hooks",
      "reason": "The user can configure and validate a default SOCKS5 proxy and a separate Tor proxy. The QML settings page commits them to Core, and the functional test checks toggles, validation, cancellation and persisted proxy/onion settings.",
      "qml": [
        "qml/pages/settings/ConnectionSettingsPage.qml",
        "qml/pages/settings/ProxySettingsPage.qml"
      ],
      "hooks": [
        "qml/models/core_settings_model.cpp",
